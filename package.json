{
  "name": "emojitown-bot",
  "version": "1.0.0",
  "description": "emojitown seasonal Discord bot: Snowball Fights, Trick or Treat, Advent Calendar and Candy Counter",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "deploy-commands": "tsx scripts/deploy-commands.ts",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grammsayy/emojitown.git"
  },
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/grammsayy/emojitown/issues"
  },
  "homepage": "https://github.com/grammsayy/emojitown#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}
