# Discord application (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# SQLite file. Put it on a persistent volume; all progress and timers live here.
DATABASE_PATH=./data/emojitown.db
# Optional: your test server ID. The bot warns at startup if it is not a member of it.
DEV_GUILD_ID=
# Optional: how often timed work runs (visitors, Advent posts, event start/end). Default 15000.
TICK_INTERVAL_MS=15000
